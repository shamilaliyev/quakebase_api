# Local development can use SQLite automatically if DATABASE_URL is not set.
# For PostgreSQL, use this format:
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/quakebase_db

# Required for JWT. Change this before deployment.
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Redis cache. If not set, the API still works without caching.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
